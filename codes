"""

# ✅ وظيفة التنظيف للنص
def normalize(text):
    text = unicodedata.normalize("NFKD", text)
    text = "".join(c for c in text if not unicodedata.combining(c))
    text = text.replace('ـ', '')
    return text

# ✅ تجهيز النصوص
original_lines = [line.strip() for line in raw_text.strip().splitlines() if line.strip()]
normalized_lines = [normalize(line) for line in original_lines]

# ✅ إعداد البوت
app = Client(
    "bot",
    api_id=api_id,
    api_hash=api_hash,
    bot_token=bot_token
)

# ✅ وظيفة البحث والرد
@app.on_message(filters.group & filters.text)
async def search_handler(client, message):
    text = message.text.strip()

    if not text.startswith("بحث"):
        return

    query = text[4:].strip()
    word_count = len(query.split())

    if word_count == 0:
        await message.reply("❌ اكتب كلمة أو أكثر بعد كلمة بحث.")
        return

    normalized_query = normalize(query)

    results = []
    for i, norm_line in enumerate(normalized_lines):
        if normalized_query in norm_line:
            results.append(original_lines[i])

    if len(results) == 0:
        await message.reply("❌ لا يوجد سطر يحتوي على هذا النص.")
    elif len(results) > 7:
        if word_count == 1:
            await message.reply("❗ الكلمة ظهرت كثيرًا، الرجاء البحث بكلمتين أو أكثر لتقليل النتائج.")
        elif word_count == 2:
            await message.reply("❗ الكلمتين ظهروا كثيرًا، الرجاء البحث بثلاث كلمات أو أكثر للتقليل.")
        else:
            await message.reply("❗ حتى مع ثلاث كلمات النتائج كثيرة، الرجاء تحديد أكثر بكلامك.")
    else:
        await message.reply('\n'.join(results))

